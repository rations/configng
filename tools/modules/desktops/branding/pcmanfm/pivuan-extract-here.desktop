# Pivuan Audio: Extract Here in pcmanfm's right-click menu for zip and tar archives, on the
# desktop and in its windows (a file-manager action, which libfm reads). Installed as
# /usr/share/file-manager/actions/pivuan-extract-here.desktop by pivuan-config; it runs
# /usr/lib/pivuan/extract-here, which unpacks each archive next to itself.
[Desktop Entry]
Type=Action
Name=Extract Here
Icon=package-x-generic
Profiles=archives;

[X-Action-Profile archives]
Name=Extract Here
MimeTypes=application/zip;application/x-zip;application/x-zip-compressed;application/x-tar;application/x-gtar;application/x-compressed-tar;application/x-bzip-compressed-tar;application/x-bzip2-compressed-tar;application/x-xz-compressed-tar;application/x-zstd-compressed-tar;application/x-lzma-compressed-tar;application/x-lzip-compressed-tar;
SelectionCount=>0
Exec=/usr/lib/pivuan/extract-here %F
