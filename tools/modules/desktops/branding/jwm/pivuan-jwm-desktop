#!/bin/sh
#
# Pivuan Audio: JWM's panel (tray) and desktop background, from the user's Desktop Settings.
# Installed as /usr/lib/pivuan/jwm-desktop; /etc/jwm/pivuan.jwmrc includes what it prints
# (<Include>exec:/usr/lib/pivuan/jwm-desktop</Include>), so JWM runs it at each start and
# restart.
#
# The settings are in ~/.config/pivuan/desktop.conf, written by Desktop Settings
# (pivuan-desktop-settings); one per line:
#   background=<picture>        the desktop background (default: Pivuan black)
#   autohide=yes|no             hide the panel at the bottom edge until the mouse reaches it
#   launcher=<name>.desktop     a program icon on the panel, in this order (from the
#                               programs' .desktop files)
#   panel_size=<pixels>         the panel's height, 20 to 96 (default 30, or 48 with a
#                               touchscreen)
#   icon_size=<pixels>          the program icons' size, 12 up to the panel's height - 8
#                               (default 22)
#   panel_colour=#RRGGBB        the panel's colour (default #959597, the grey of the Pivuan logo);
#                               its text is light on a dark panel and dark on a light one
#   keyboard=auto|yes|no        the on-screen keyboard (Onboard): a panel button that shows and
#                               hides it, and Onboard started hidden at login. auto (default):
#                               only when a touchscreen is attached (/usr/lib/pivuan/keyboard)
#   desktop_icons=yes|no        icons on the desktop: the files in the Desktop folder, such as
#                               the shortcuts Windows installers make (default yes); pcmanfm
#                               draws them (/usr/lib/pivuan/desktop-icons)
#   screen_off=yes|no           turn the screen off after 10 minutes without use (X's own
#                               default). Default no: the screen stays on
#   brightness=<percent>        the screen's brightness, 10 to 100, put back at each start by
#                               /usr/lib/pivuan/brightness (which reads it itself). Not set by
#                               default: the screen keeps its own
#   brightness_button=yes|no    a panel button that opens the brightness slider (default yes)
#   long_press=yes|no           with a touchscreen, a finger held still is a right click
#                               (/usr/lib/pivuan/long-press, which reads it itself; default yes)
# Without the file, or with lines it does not understand, the defaults are used: the panel
# always comes up.
#
# With a touchscreen (/usr/lib/pivuan/keyboard touch), the window borders and title bars are
# bigger, so a finger can take hold of them, and the panel's tooltips are off (after a tap
# they would stay up).
#
# The icons: JWM draws a panel icon 8 pixels smaller than the panel, whatever its own size.
# Desktop Settings makes each program's icon (and the speaker's) a square PNG of exactly that
# size, with the icon at icon_size in the middle, in ~/.config/pivuan/panel-icons/<name>.png,
# so all are the same size. Without that file, the icon is looked up by its name.
#
config="${XDG_CONFIG_HOME:-${HOME}/.config}/pivuan/desktop.conf"
default_background=/usr/share/backgrounds/pivuan/background-black.png

background=""
autohide=no
launchers=""
panel_size=""
panel_colour="#959597"
keyboard=auto
desktop_icons=yes
screen_off=no
brightness_button=yes
if [ -r "${config}" ]; then
	while IFS= read -r line || [ -n "${line}" ]; do
		case "${line}" in
			background=*) background="${line#background=}" ;;
			autohide=yes) autohide=yes ;;
			keyboard=auto | keyboard=yes | keyboard=no) keyboard="${line#keyboard=}" ;;
			desktop_icons=yes | desktop_icons=no) desktop_icons="${line#desktop_icons=}" ;;
			screen_off=yes) screen_off=yes ;;
			brightness_button=no) brightness_button=no ;;
			panel_size=*)
				value="${line#panel_size=}"
				case "${value}" in
					"" | *[!0-9]*) ;;
					*) [ "${value}" -ge 20 ] && [ "${value}" -le 96 ] && panel_size="${value}" ;;
				esac
				;;
			panel_colour=\#??????)
				value="${line#panel_colour=}"
				case "${value}" in \#*[!0-9A-Fa-f]*) ;; *) panel_colour="${value}" ;; esac
				;;
			launcher=*.desktop)
				id="${line#launcher=}"
				case "${id}" in */*) ;; *) launchers="${launchers} ${id}" ;; esac
				;;
		esac
	done < "${config}"
fi
[ -n "${background}" ] && [ -f "${background}" ] || background="${default_background}"

# A touchscreen: bigger panel, borders and title bars.
touch=no
[ -x /usr/lib/pivuan/keyboard ] && /usr/lib/pivuan/keyboard touch && touch=yes
if [ -z "${panel_size}" ]; then
	if [ "${touch}" = yes ]; then panel_size=48; else panel_size=30; fi
fi

# The saved brightness, put back at each start (in the background: over HDMI it takes a
# moment, and JWM waits for what this prints).
[ -x /usr/lib/pivuan/brightness ] && /usr/lib/pivuan/brightness restore > /dev/null 2>&1 &

# The screen's blanking and power saving, set here rather than printed: JWM runs this at each
# start and restart, so at login and whenever Desktop Settings applies. X blanks the screen
# and turns the monitor off after 10 minutes by default; by default here it stays on.
if command -v xset > /dev/null 2>&1; then
	if [ "${screen_off}" = yes ]; then
		xset s 600 600 +dpms dpms 600 600 600
	else
		xset s off -dpms
	fi
fi > /dev/null 2>&1

icons="${XDG_CONFIG_HOME:-${HOME}/.config}/pivuan/panel-icons"

# The on-screen keyboard, when it is wanted and Onboard is installed.
if [ "${keyboard}" = auto ]; then
	if [ -x /usr/lib/pivuan/keyboard ] && /usr/lib/pivuan/keyboard touch; then
		keyboard=yes
	else
		keyboard=no
	fi
fi
command -v onboard > /dev/null 2>&1 || keyboard=no
# The brightness button opens Desktop Settings' brightness slider.
[ -x /usr/lib/pivuan/brightness ] && command -v pivuan-desktop-settings > /dev/null 2>&1 \
	|| brightness_button=no

# The panel's text: dark on a light panel, light on a dark one (perceived brightness of
# #RRGGBB); the pager's other desktops a little towards the text colour.
hex_byte() { printf '%d' "0x$(printf '%s' "$1" | cut -c "$2-$(($2 + 1))")"; }
red="$(hex_byte "${panel_colour}" 2)"
green="$(hex_byte "${panel_colour}" 4)"
blue="$(hex_byte "${panel_colour}" 6)"
if [ $(((299 * red + 587 * green + 114 * blue) / 1000)) -gt 140 ]; then
	text="#1E1E1E"
	shade=0
else
	text="#ECECEC"
	shade=255
fi
pager="$(printf '#%02X%02X%02X' $(((red * 85 + shade * 15) / 100)) $(((green * 85 + shade * 15) / 100)) \
	$(((blue * 85 + shade * 15) / 100)))"
# The menu button's logo: on a dark panel the logo as it is; on any other (the default
# #959597 is the grey of the logo's "v" and traces) the one with them outlined in white
# (pivuan-config's /usr/share/pixmaps/pivuan/pivuan-panel.png).
logo=/usr/share/pixmaps/pivuan/pivuan.png
if [ $(((299 * red + 587 * green + 114 * blue) / 1000)) -ge 96 ] \
	&& [ -f /usr/share/pixmaps/pivuan/pivuan-panel.png ]; then
	logo=/usr/share/pixmaps/pivuan/pivuan-panel.png
fi

# Text for XML: & < > " escaped.
xml() {
	printf '%s' "$1" | sed -e 's/&/\&amp;/g' -e 's/</\&lt;/g' -e 's/>/\&gt;/g' -e 's/"/\&quot;/g'
}

# A program's .desktop file, by its name, where menus look for it (the user's own first).
desktop_file() {
	for dir in "${XDG_DATA_HOME:-${HOME}/.local/share}/applications" /usr/local/share/applications \
		/usr/share/applications; do
		[ -f "${dir}/$1" ] && echo "${dir}/$1" && return 0
	done
	return 1
}

# A panel button for a .desktop file: its icon, its name as the tooltip, and its command
# (without the %f, %u ... placeholders). Programs that run in a terminal get one.
launcher_button() {
	awk '
		/^\[/ { in_entry = ($0 == "[Desktop Entry]"); next }
		!in_entry { next }
		/^Name=/ && name == "" { name = substr($0, 6) }
		/^Icon=/ && icon == "" { icon = substr($0, 6) }
		/^Exec=/ && exec_line == "" { exec_line = substr($0, 6) }
		/^Terminal=true/ { terminal = 1 }
		/^Hidden=true/ { hidden = 1 }
		END {
			if (exec_line == "" || hidden) exit 1
			gsub(/%[fFuUdDnNickvm]/, "", exec_line)
			gsub(/%%/, "%", exec_line)
			sub(/[ \t]+$/, "", exec_line)
			if (terminal) exec_line = "lxterminal -e " exec_line
			printf "%s\n%s\n%s\n", name, icon, exec_line
		}' "$1"
}

echo '<?xml version="1.0"?>'
echo '<JWM>'
if [ "${autohide}" = yes ]; then hide=bottom; else hide=off; fi
echo "    <Tray x=\"0\" y=\"-1\" height=\"${panel_size}\" autohide=\"${hide}\">"
# The Pivuan menu (jgmenu, /usr/lib/pivuan/menu), above the panel; the menu reads the panel's
# height and autohide from the same file.
echo "        <TrayButton icon=\"${logo}\" popup=\"Pivuan menu\">exec:/usr/lib/pivuan/menu panel</TrayButton>"
echo '        <Spacer width="4"/>'
buttons=0
for id in ${launchers}; do
	file="$(desktop_file "${id}")" || continue
	entry="$(launcher_button "${file}")" || continue
	name="$(printf '%s\n' "${entry}" | sed -n 1p)"
	icon="$(printf '%s\n' "${entry}" | sed -n 2p)"
	command="$(printf '%s\n' "${entry}" | sed -n 3p)"
	[ -n "${icon}" ] || icon=application-x-executable
	[ -f "${icons}/${id%.desktop}.png" ] && icon="${icons}/${id%.desktop}.png"
	echo "        <TrayButton icon=\"$(xml "${icon}")\" popup=\"$(xml "${name}")\">exec:$(xml "${command}")</TrayButton>"
	buttons=$((buttons + 1))
done
[ "${buttons}" -eq 0 ] || echo '        <Spacer width="4"/>'
speaker=audio-speakers
[ -f "${icons}/audio-speakers.png" ] && speaker="${icons}/audio-speakers.png"
echo '        <Pager labeled="true"/>'
echo '        <TaskList maxwidth="240"/>'
echo '        <Dock/>'
if [ "${keyboard}" = yes ]; then
	kbd_icon=input-keyboard
	[ -f "${icons}/input-keyboard.png" ] && kbd_icon="${icons}/input-keyboard.png"
	echo "        <TrayButton icon=\"$(xml "${kbd_icon}")\" popup=\"On-screen keyboard\">exec:/usr/lib/pivuan/keyboard toggle</TrayButton>"
fi
if [ "${brightness_button}" = yes ]; then
	# Numix has the icon only among its notification icons, where JWM does not look.
	bright_icon=display-brightness
	[ -f /usr/share/icons/Numix/48/notifications/notification-display-brightness.svg ] \
		&& bright_icon=/usr/share/icons/Numix/48/notifications/notification-display-brightness.svg
	[ -f "${icons}/display-brightness.png" ] && bright_icon="${icons}/display-brightness.png"
	echo "        <TrayButton icon=\"$(xml "${bright_icon}")\" popup=\"Brightness\">exec:pivuan-desktop-settings --brightness</TrayButton>"
fi
# Volume: a click (a tap) opens Desktop Settings' volume slider, with mute and Volume Control;
# the other buttons open Volume Control itself; the wheel changes the volume.
volume_click=pavucontrol
command -v pivuan-desktop-settings > /dev/null 2>&1 && volume_click="pivuan-desktop-settings --volume"
echo "        <TrayButton icon=\"$(xml "${speaker}")\" popup=\"Volume (scroll to change it)\">"
echo "            <Button mask=\"1\">exec:${volume_click}</Button>"
cat << 'EOF'
            <Button mask="23">exec:pavucontrol</Button>
            <Button mask="4">exec:pactl set-sink-volume @DEFAULT_SINK@ +5%</Button>
            <Button mask="5">exec:pactl set-sink-volume @DEFAULT_SINK@ -5%</Button>
        </TrayButton>
        <Clock format="%a %d %b  %H:%M"/>
        <Spacer width="4"/>
    </Tray>
EOF
# Onboard starts hidden, so the first tap on the keyboard button shows it at once. JWM runs a
# StartupCommand when it starts, not when it restarts.
[ "${keyboard}" = yes ] && echo '    <StartupCommand>/usr/lib/pivuan/keyboard start</StartupCommand>'
# Long press for right click on a touchscreen (the pivuan-long-press package, from the Pivuan apt
# repository; it reads long_press= itself, and Desktop Settings restarts it when that changes).
[ "${touch}" = yes ] && [ -x /usr/lib/pivuan/long-press ] \
	&& echo '    <StartupCommand>/usr/lib/pivuan/long-press start</StartupCommand>'
# The desktop icons (pcmanfm's desktop, over JWM's background, with the same picture). Desktop
# Settings starts and stops them itself when they are turned on or off.
[ "${desktop_icons}" = yes ] && [ -x /usr/lib/pivuan/desktop-icons ] \
	&& echo '    <StartupCommand>/usr/lib/pivuan/desktop-icons start</StartupCommand>'
# The desktop follows the monitors (Monitor Settings, a monitor plugged in or out): the desktop
# icons start again at the new places, and touch stays on the touchscreen's own monitor.
[ -x /usr/lib/pivuan/monitors ] && echo '    <StartupCommand>/usr/lib/pivuan/monitors start</StartupCommand>'
echo '    <Desktops width="2" height="1">'
echo "        <Background type=\"scale\">$(xml "${background}")</Background>"
echo '    </Desktops>'
# The panel's colours (the gold of the active window and desktop is Pivuan's).
cat << EOF
    <TrayStyle decorations="flat">
        <Font>DejaVu Sans-10</Font>
        <Background>${panel_colour}</Background>
        <Foreground>${text}</Foreground>
        <Opacity>1.0</Opacity>
    </TrayStyle>
    <TaskListStyle list="all" group="false">
        <Font>DejaVu Sans-10</Font>
        <Foreground>${text}</Foreground>
        <Background>${panel_colour}</Background>
        <Active>
            <Foreground>#1E1E1E</Foreground>
            <Background>#B88B4C</Background>
        </Active>
    </TaskListStyle>
    <PagerStyle>
        <Foreground>${pager}</Foreground>
        <Background>${panel_colour}</Background>
        <Text>${text}</Text>
        <Active>
            <Foreground>#D4A865</Foreground>
            <Background>#B88B4C</Background>
        </Active>
    </PagerStyle>
EOF
# Touchscreen: borders a finger can take hold of (with the title bar's height, the corners grow
# too) and bigger title-bar buttons; no tooltips. pivuan.jwmrc includes this after its own
# WindowStyle, so these win.
if [ "${touch}" = yes ]; then
	cat << 'EOF'
    <WindowStyle>
        <Width>8</Width>
        <Height>34</Height>
    </WindowStyle>
    <PopupStyle enabled="false"/>
EOF
fi
echo '</JWM>'
