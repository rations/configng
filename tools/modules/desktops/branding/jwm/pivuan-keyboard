#!/bin/sh
#
# Pivuan Audio: the on-screen keyboard (Onboard), for touchscreens. Installed as
# /usr/lib/pivuan/keyboard by postinst/audio.sh.
#
#   keyboard toggle   show the keyboard, or hide it if it is showing (the panel button and the
#                     System menu); starts Onboard first if it is not running
#   keyboard start    start Onboard hidden, at login, so the first tap shows it at once
#   keyboard touch    exit 0 if a touchscreen is attached
#
# Onboard's D-Bus service is org.onboard.Onboard, object /org/onboard/Onboard/Keyboard,
# interface org.onboard.Onboard.Keyboard, with the methods Show and Hide and the property
# Visible (Onboard 1.4.1, Onboard/OnboardGtk.py). It is on the session bus dbus-run-session gives
# the session (~/.xinitrc). Onboard has no D-Bus service file, so the bus cannot start it: toggle
# starts it itself when it is not running. That happens when the keyboard is set to Never or
# Automatic without a touchscreen (the menu item is always there), and when the keyboard was
# turned on in Desktop Settings: JWM runs StartupCommand when it starts, not when it restarts.
# Onboard starts hidden (start-minimized in /etc/onboard/onboard-defaults.conf); it takes its
# name on the bus after it has hidden itself, so a Show sent then is not undone.
#
name=org.onboard.Onboard
object=/org/onboard/Onboard/Keyboard
interface=org.onboard.Onboard.Keyboard

# True if Onboard holds its name on the session bus, i.e. is running.
running() {
	dbus-send --session --print-reply --dest=org.freedesktop.DBus /org/freedesktop/DBus \
		org.freedesktop.DBus.NameHasOwner string:"${name}" 2> /dev/null | grep -q 'boolean true'
}

# True if the keyboard is showing (Onboard's Visible property).
visible() {
	dbus-send --session --print-reply --dest="${name}" "${object}" \
		org.freedesktop.DBus.Properties.Get string:"${interface}" string:Visible 2> /dev/null \
		| grep -q 'boolean true'
}

# Call one of Onboard's methods (Show, Hide).
call() {
	dbus-send --session --type=method_call --dest="${name}" "${object}" "${interface}.$1" \
		> /dev/null 2>&1
}

# A touchscreen is an input device with INPUT_PROP_DIRECT (bit 0) in its properties bitmap
# (linux/input-event-codes.h), printed by the kernel in hex: a touchpad or a mouse does not
# have it. The login screen (xlogin) uses the same test.
touchscreen() {
	for file in /sys/class/input/input*/properties; do
		[ -r "${file}" ] || continue
		read -r bits < "${file}" || continue
		last="${bits##* }"
		case "${last}" in "" | *[!0-9a-fA-F]*) continue ;; esac
		[ $((0x${last} & 1)) -ne 0 ] && return 0
	done
	return 1
}

case "$1" in
	toggle)
		command -v onboard > /dev/null 2>&1 || exit 1
		if running; then
			if visible; then call Hide; else call Show; fi
			exit 0
		fi
		# Not running: start it and wait (up to 15 s, the Pi 3 is slow to start Python) for
		# its name on the bus, then show it.
		onboard > /dev/null 2>&1 &
		tries=0
		until running; do
			tries=$((tries + 1))
			[ "${tries}" -le 150 ] || exit 1
			sleep 0.1
		done
		call Show
		;;
	start)
		command -v onboard > /dev/null 2>&1 || exit 0
		running || onboard > /dev/null 2>&1 &
		;;
	touch)
		touchscreen
		;;
	*)
		echo "usage: $0 toggle|start|touch" >&2
		exit 2
		;;
esac
