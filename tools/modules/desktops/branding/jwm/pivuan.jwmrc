<?xml version="1.0"?>
<!--
    Pivuan Audio: JWM menu, tray and look. Installed as /etc/jwm/pivuan.jwmrc by
    pivuan-config and replaced when Pivuan Audio is installed again. Each user's
    ~/.jwmrc includes this file; put your own settings there (see that file).
-->
<JWM>

    <!-- Programs started with the session. JWM does not run XDG autostart
         entries itself, so they are started here: the user's own autostart
         entries (~/.config/autostart, such as the screen layout saved by
         lxrandr), the compositor (picom, /etc/pivuan/picom.conf: smooth window
         moves, no redraw trails or tearing), the
         polkit password dialog, PulseAudio (it also plays into JACK while JACK
         runs), and the network and Bluetooth applets. -->
    <StartupCommand>/usr/lib/pivuan/autostart</StartupCommand>
    <StartupCommand>picom -b --config /etc/pivuan/picom.conf</StartupCommand>
    <StartupCommand>lxpolkit</StartupCommand>
    <StartupCommand>/usr/lib/pivuan/pulse-session</StartupCommand>
    <StartupCommand>nm-applet</StartupCommand>
    <StartupCommand>blueman-applet</StartupCommand>

    <!-- The Pivuan menu: tray button, left or right click on the desktop, Alt+F1. -->
    <RootMenu onroot="13">
        <Program icon="lxterminal" label="Terminal">lxterminal</Program>
        <Program icon="user-home" label="Files">pcmanfm</Program>
        <Program icon="brave-origin" label="Web Browser">brave-origin-stable</Program>
        <Separator/>
        <Menu icon="audio-card" label="Audio">
            <Program icon="audio-speakers" label="Volume Control">pavucontrol</Program>
            <Program icon="audio-card" label="Jack Graph">jack-graph</Program>
            <Program icon="jackdaw" label="JackDAW">jackdaw</Program>
            <Program icon="namp-rack" label="NAMp Rack">namp-rack</Program>
            <Program icon="audio-card" label="NAMix">namix-standalone</Program>
            <Program icon="audio-card" label="DRUMix">drumix-standalone</Program>
        </Menu>
        <Menu icon="applications-accessories" label="Accessories">
            <Program icon="org.xfce.mousepad" label="Text Editor">mousepad</Program>
            <Program icon="io.github.celluloid_player.Celluloid" label="Media Player">celluloid</Program>
        </Menu>
        <Menu icon="preferences-system" label="System">
            <Program icon="/usr/share/pixmaps/pivuan/pivuan.png" label="Pivuan Config">lxterminal -e sudo pivuan-config</Program>
            <Program icon="cpu-power" label="CPU Power">cpu-power</Program>
            <Program icon="network-wired" label="Network Connections">nm-connection-editor</Program>
            <Program icon="blueman" label="Bluetooth">blueman-manager</Program>
            <Program icon="video-display" label="Display">lxrandr</Program>
            <Program icon="preferences-desktop-personal" label="Desktop Settings">pivuan-desktop-settings</Program>
            <Program icon="preferences-desktop-theme" label="Appearance">lxappearance</Program>
        </Menu>
        <Separator/>
        <Restart icon="view-refresh" label="Restart JWM"/>
        <Exit icon="system-log-out" label="Log Out" confirm="true"/>
        <!-- JWM exits first, then runs the command; elogind and Pivuan's polkit
             rule let a local administrator restart and shut down. -->
        <Exit icon="system-reboot" label="Reboot" confirm="true">loginctl reboot</Exit>
        <Exit icon="system-shutdown" label="Shut Down" confirm="true">loginctl poweroff</Exit>
    </RootMenu>

    <Group>
        <Option>tiled</Option>
    </Group>

    <!-- Tray at the bottom (menu, program icons, desktops, windows, applets,
         volume, clock) and the desktop background: printed by
         /usr/lib/pivuan/jwm-desktop from the user's Desktop Settings
         (~/.config/pivuan/desktop.conf). Volume: a click opens Volume Control,
         the scroll wheel changes the volume of the current output. -->
    <Include>exec:/usr/lib/pivuan/jwm-desktop</Include>

    <!-- Look: the greys of the Pivuan artwork, and the gold of NAMp-rations. Text on
         gold is dark: white on this gold is hard to read. -->
    <WindowStyle decorations="flat">
        <Font>DejaVu Sans-10:bold</Font>
        <Width>3</Width>
        <Height>24</Height>
        <Corner>0</Corner>
        <Foreground>#C8C8C8</Foreground>
        <Background>#414141</Background>
        <Outline>#1E1E1E</Outline>
        <Opacity>1.0</Opacity>
        <Active>
            <Foreground>#1E1E1E</Foreground>
            <Background>#B88B4C</Background>
            <Outline>#1E1E1E</Outline>
            <Opacity>1.0</Opacity>
        </Active>
    </WindowStyle>
    <TrayStyle decorations="flat">
        <Font>DejaVu Sans-10</Font>
        <Background>#2B2B2B</Background>
        <Foreground>#ECECEC</Foreground>
        <Opacity>1.0</Opacity>
    </TrayStyle>
    <TaskListStyle list="all" group="false">
        <Font>DejaVu Sans-10</Font>
        <Foreground>#ECECEC</Foreground>
        <Background>#2B2B2B</Background>
        <Active>
            <Foreground>#1E1E1E</Foreground>
            <Background>#B88B4C</Background>
        </Active>
    </TaskListStyle>
    <PagerStyle>
        <Foreground>#414141</Foreground>
        <Background>#2B2B2B</Background>
        <Text>#ECECEC</Text>
        <Active>
            <Foreground>#D4A865</Foreground>
            <Background>#B88B4C</Background>
        </Active>
    </PagerStyle>
    <MenuStyle decorations="flat">
        <Font>DejaVu Sans-10</Font>
        <Foreground>#ECECEC</Foreground>
        <Background>#333333</Background>
        <Outline>#1E1E1E</Outline>
        <Active>
            <Foreground>#1E1E1E</Foreground>
            <Background>#B88B4C</Background>
        </Active>
        <Opacity>1.0</Opacity>
    </MenuStyle>
    <PopupStyle>
        <Font>DejaVu Sans-10</Font>
        <Foreground>#1E1E1E</Foreground>
        <Background>#ECECEC</Background>
    </PopupStyle>

    <!-- Icons: JWM looks only in these folders, in this order. The Numix theme
         first (as on MATE and XFCE; its action icons stop at 32 pixels), then
         the programs' own icons. -->
    <IconPath>/usr/share/icons/Numix/48/apps</IconPath>
    <IconPath>/usr/share/icons/Numix/48/categories</IconPath>
    <IconPath>/usr/share/icons/Numix/48/devices</IconPath>
    <IconPath>/usr/share/icons/Numix/48/places</IconPath>
    <IconPath>/usr/share/icons/Numix/48/status</IconPath>
    <IconPath>/usr/share/icons/Numix/48/mimetypes</IconPath>
    <IconPath>/usr/share/icons/Numix/32/actions</IconPath>
    <IconPath>/usr/share/icons/Numix/32/categories</IconPath>
    <IconPath>/usr/share/icons/hicolor/48x48/apps</IconPath>
    <IconPath>/usr/share/icons/hicolor/64x64/apps</IconPath>
    <IconPath>/usr/share/icons/hicolor/128x128/apps</IconPath>
    <IconPath>/usr/share/icons/hicolor/256x256/apps</IconPath>
    <IconPath>/usr/share/icons/hicolor/scalable/apps</IconPath>
    <IconPath>/usr/share/icons/Adwaita/scalable/apps</IconPath>
    <IconPath>/usr/share/icons/Adwaita/scalable/devices</IconPath>
    <IconPath>/usr/share/icons/Adwaita/scalable/categories</IconPath>
    <IconPath>/usr/share/icons/Adwaita/scalable/actions</IconPath>
    <IconPath>/usr/share/icons/Adwaita/symbolic/apps</IconPath>
    <IconPath>/usr/share/icons/Adwaita/symbolic/devices</IconPath>
    <IconPath>/usr/share/icons/Adwaita/symbolic/categories</IconPath>
    <IconPath>/usr/share/icons/Adwaita/symbolic/actions</IconPath>
    <IconPath>/usr/share/pixmaps</IconPath>

    <DoubleClickSpeed>400</DoubleClickSpeed>
    <DoubleClickDelta>2</DoubleClickDelta>
    <FocusModel>click</FocusModel>
    <SnapMode distance="10">border</SnapMode>
    <MoveMode>opaque</MoveMode>
    <!-- Resizing shows an outline; the window redraws once at the end (no lines
         from redrawing at every step). -->
    <ResizeMode>outline</ResizeMode>

    <!-- Keys -->
    <Key key="Up">up</Key>
    <Key key="Down">down</Key>
    <Key key="Right">right</Key>
    <Key key="Left">left</Key>
    <Key key="Return">select</Key>
    <Key key="Escape">escape</Key>

    <Key mask="A" key="Tab">nextstacked</Key>
    <Key mask="A" key="F4">close</Key>
    <Key mask="A" key="#">desktop#</Key>
    <Key mask="A" key="F1">root:1</Key>
    <Key mask="A" key="F2">window</Key>
    <Key mask="A" key="F10">maximize</Key>
    <Key mask="A" key="Right">rdesktop</Key>
    <Key mask="A" key="Left">ldesktop</Key>
    <Key mask="CA" key="t">exec:lxterminal</Key>

    <!-- Mouse -->
    <Mouse context="root" button="4">ldesktop</Mouse>
    <Mouse context="root" button="5">rdesktop</Mouse>

    <Mouse context="title" button="1">move</Mouse>
    <Mouse context="title" button="2">move</Mouse>
    <Mouse context="title" button="3">window</Mouse>
    <Mouse context="title" button="4">shade</Mouse>
    <Mouse context="title" button="5">shade</Mouse>
    <Mouse context="title" button="11">maximize</Mouse>

    <Mouse context="icon" button="1">window</Mouse>
    <Mouse context="icon" button="2">move</Mouse>
    <Mouse context="icon" button="3">window</Mouse>
    <Mouse context="icon" button="4">shade</Mouse>
    <Mouse context="icon" button="5">shade</Mouse>

    <Mouse context="border" button="1">resize</Mouse>
    <Mouse context="border" button="2">move</Mouse>
    <Mouse context="border" button="3">window</Mouse>

    <Mouse context="close" button="-1">close</Mouse>
    <Mouse context="close" button="2">move</Mouse>
    <Mouse context="close" button="-3">close</Mouse>

    <Mouse context="maximize" button="-1">maximize</Mouse>
    <Mouse context="maximize" button="-2">maxv</Mouse>
    <Mouse context="maximize" button="-3">maxh</Mouse>

    <Mouse context="minimize" button="-1">minimize</Mouse>
    <Mouse context="minimize" button="2">move</Mouse>
    <Mouse context="minimize" button="-3">shade</Mouse>

</JWM>
