#!/usr/bin/python3
#
# Pivuan Audio: Desktop Settings for JWM. The desktop background, program icons on the panel,
# and hiding the panel. Installed as /usr/bin/pivuan-desktop-settings (System > Desktop
# Settings in the Pivuan menu).
#
# Writes ~/.config/pivuan/desktop.conf and restarts JWM (open windows stay); JWM gets the
# panel and background from /usr/lib/pivuan/jwm-desktop, which reads that file.
#
#   pivuan-desktop-settings           the window
#   pivuan-desktop-settings --check   load the settings and GTK without a window (tests)
#
import os
import subprocess
import sys

import gi

gi.require_version("Gtk", "3.0")
gi.require_version("GdkPixbuf", "2.0")
gi.require_version("Pango", "1.0")
from gi.repository import GdkPixbuf, Gio, GLib, Gtk, Pango  # noqa: E402

BACKGROUNDS = "/usr/share/backgrounds/pivuan"
DEFAULT_BACKGROUND = os.path.join(BACKGROUNDS, "background-dark-gray.png")
CONFIG = os.path.join(GLib.get_user_config_dir(), "pivuan", "desktop.conf")
THUMB_WIDTH, THUMB_HEIGHT = 128, 72
ICON_SIZE = 32


def load_settings():
    """The settings in desktop.conf, or the defaults."""
    settings = {"background": DEFAULT_BACKGROUND, "autohide": False, "launchers": []}
    try:
        with open(CONFIG, encoding="utf-8") as f:
            for line in f:
                key, _, value = line.rstrip("\n").partition("=")
                if key == "background" and value:
                    settings["background"] = value
                elif key == "autohide":
                    settings["autohide"] = value == "yes"
                elif key == "launcher" and value.endswith(".desktop") and "/" not in value:
                    settings["launchers"].append(value)
    except OSError:
        pass
    return settings


def save_settings(settings):
    """Write desktop.conf in one go (a new file moved over the old one)."""
    os.makedirs(os.path.dirname(CONFIG), exist_ok=True)
    lines = [
        "# Pivuan desktop settings, written by Desktop Settings (pivuan-desktop-settings).",
        "background=" + settings["background"],
        "autohide=" + ("yes" if settings["autohide"] else "no"),
    ]
    lines += ["launcher=" + app_id for app_id in settings["launchers"]]
    tmp = CONFIG + ".new"
    with open(tmp, "w", encoding="utf-8") as f:
        f.write("\n".join(lines) + "\n")
    os.replace(tmp, CONFIG)


def app_info(app_id):
    try:
        return Gio.DesktopAppInfo.new(app_id)
    except TypeError:
        return None


def app_icon(info):
    icon = info.get_icon() if info else None
    if icon is None:
        return Gtk.Image.new_from_icon_name("application-x-executable", Gtk.IconSize.DND)
    image = Gtk.Image.new_from_gicon(icon, Gtk.IconSize.DND)
    image.set_pixel_size(ICON_SIZE)
    return image


def thumbnail(path):
    try:
        return GdkPixbuf.Pixbuf.new_from_file_at_scale(path, THUMB_WIDTH, THUMB_HEIGHT, False)
    except GLib.Error:
        return None


def colour_name(path):
    """background-dark-gray.png -> Dark Gray; other pictures: their file name."""
    name = os.path.basename(path)
    if name.startswith("background-") and name.endswith(".png"):
        return name[len("background-"):-len(".png")].replace("-", " ").title()
    return name


class AddProgramDialog(Gtk.Dialog):
    """The installed programs, with a search box; returns the chosen one's .desktop name."""

    def __init__(self, parent, exclude):
        super().__init__(title="Add a program to the panel", transient_for=parent, modal=True)
        self.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Add", Gtk.ResponseType.OK)
        self.set_default_size(420, 480)
        self.set_default_response(Gtk.ResponseType.OK)
        box = self.get_content_area()
        box.set_spacing(6)
        box.set_border_width(8)

        self.search = Gtk.SearchEntry(placeholder_text="Search")
        self.search.connect("search-changed", lambda *_: self.list.invalidate_filter())
        box.pack_start(self.search, False, False, 0)

        self.list = Gtk.ListBox()
        self.list.set_filter_func(self.matches)
        self.list.connect("row-activated", lambda *_: self.response(Gtk.ResponseType.OK))
        apps = [a for a in Gio.AppInfo.get_all() if a.should_show() and a.get_id() not in exclude]
        for app in sorted(apps, key=lambda a: a.get_display_name().lower()):
            row = Gtk.ListBoxRow()
            row.app_id = app.get_id()
            row.label = app.get_display_name()
            line = Gtk.Box(spacing=8, border_width=4)
            line.pack_start(app_icon(app), False, False, 0)
            line.pack_start(Gtk.Label(label=row.label, xalign=0), True, True, 0)
            row.add(line)
            self.list.add(row)
        scrolled = Gtk.ScrolledWindow(vexpand=True)
        scrolled.add(self.list)
        box.pack_start(scrolled, True, True, 0)
        self.show_all()

    def matches(self, row):
        text = self.search.get_text().strip().lower()
        return not text or text in row.label.lower()

    def chosen(self):
        row = self.list.get_selected_row()
        return row.app_id if row else None


class DesktopSettings(Gtk.Window):
    def __init__(self):
        super().__init__(title="Desktop Settings")
        self.set_default_size(640, 600)
        self.set_icon_name("preferences-desktop-personal")
        self.settings = load_settings()

        outer = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=12, border_width=12)
        self.add(outer)

        # Background: the Pivuan backgrounds, and any other picture.
        outer.pack_start(self.heading("Background"), False, False, 0)
        self.pictures = Gtk.FlowBox(selection_mode=Gtk.SelectionMode.SINGLE,
                                    min_children_per_line=4, max_children_per_line=4,
                                    homogeneous=True, column_spacing=6, row_spacing=6)
        self.pictures.connect("selected-children-changed", self.picture_chosen)
        outer.pack_start(self.pictures, False, False, 0)
        other = Gtk.Button(label="Other picture…", halign=Gtk.Align.START)
        other.connect("clicked", self.other_picture)
        outer.pack_start(other, False, False, 0)
        self.fill_pictures()

        # Panel: hide it, and the program icons on it.
        outer.pack_start(self.heading("Panel"), False, False, 0)
        self.autohide = Gtk.CheckButton(label="Hide the panel when not in use "
                                              "(move the mouse to the bottom edge to show it)")
        self.autohide.set_active(self.settings["autohide"])
        outer.pack_start(self.autohide, False, False, 0)
        outer.pack_start(Gtk.Label(label="Program icons on the panel, from left to right:",
                                   xalign=0), False, False, 0)
        lists = Gtk.Box(spacing=6)
        self.launchers = Gtk.ListBox()
        scrolled = Gtk.ScrolledWindow(vexpand=True, shadow_type=Gtk.ShadowType.IN,
                                      min_content_height=120)
        scrolled.add(self.launchers)
        lists.pack_start(scrolled, True, True, 0)
        buttons = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=6)
        for label, action in (("Add…", self.add_launcher), ("Remove", self.remove_launcher),
                              ("Move left", lambda *_: self.move_launcher(-1)),
                              ("Move right", lambda *_: self.move_launcher(1))):
            button = Gtk.Button(label=label)
            button.connect("clicked", action)
            buttons.pack_start(button, False, False, 0)
        lists.pack_start(buttons, False, False, 0)
        outer.pack_start(lists, True, True, 0)
        self.fill_launchers()

        # Close and Apply.
        actions = Gtk.Box(spacing=6, halign=Gtk.Align.END)
        close = Gtk.Button(label="Close")
        close.connect("clicked", lambda *_: self.destroy())
        apply = Gtk.Button(label="Apply")
        apply.get_style_context().add_class("suggested-action")
        apply.connect("clicked", self.apply)
        actions.pack_start(close, False, False, 0)
        actions.pack_start(apply, False, False, 0)
        outer.pack_start(actions, False, False, 0)
        self.connect("destroy", Gtk.main_quit)

    @staticmethod
    def heading(text):
        label = Gtk.Label(xalign=0)
        label.set_markup("<b>" + GLib.markup_escape_text(text) + "</b>")
        return label

    def fill_pictures(self):
        self.current_picture = None
        for child in self.pictures.get_children():
            self.pictures.remove(child)
        try:
            paths = sorted(os.path.join(BACKGROUNDS, n) for n in os.listdir(BACKGROUNDS)
                           if n.startswith("background-") and n.endswith(".png"))
        except OSError:
            paths = []
        current = self.settings["background"]
        if current not in paths and os.path.isfile(current):
            paths.append(current)
        for path in paths:
            pixbuf = thumbnail(path)
            if pixbuf is None:
                continue
            box = Gtk.Box(orientation=Gtk.Orientation.VERTICAL, spacing=2, border_width=4)
            box.pack_start(Gtk.Image.new_from_pixbuf(pixbuf), False, False, 0)
            box.pack_start(Gtk.Label(label=colour_name(path), ellipsize=Pango.EllipsizeMode.END,
                                     max_width_chars=18), False, False, 0)
            child = Gtk.FlowBoxChild()
            child.path = path
            child.set_tooltip_text(path)
            child.add(box)
            self.pictures.add(child)
            if path == current:
                self.current_picture = child
        self.pictures.show_all()
        self.show_current_picture()

    def show_current_picture(self):
        """Select the saved background, and give it the keyboard focus (in a FlowBox, the
        focus selects: left elsewhere, it would select the first picture)."""
        if self.current_picture is not None:
            self.pictures.select_child(self.current_picture)
            self.current_picture.grab_focus()
        else:
            self.pictures.unselect_all()

    def picture_chosen(self, flowbox):
        chosen = flowbox.get_selected_children()
        if chosen:
            self.settings["background"] = chosen[0].path

    def other_picture(self, _button):
        dialog = Gtk.FileChooserDialog(title="Choose a picture", transient_for=self,
                                       action=Gtk.FileChooserAction.OPEN)
        dialog.add_buttons("Cancel", Gtk.ResponseType.CANCEL, "Open", Gtk.ResponseType.OK)
        images = Gtk.FileFilter()
        images.set_name("Pictures")
        images.add_pixbuf_formats()
        dialog.add_filter(images)
        pictures = GLib.get_user_special_dir(GLib.UserDirectory.DIRECTORY_PICTURES)
        dialog.set_current_folder(pictures or GLib.get_home_dir())
        if dialog.run() == Gtk.ResponseType.OK and dialog.get_filename():
            self.settings["background"] = dialog.get_filename()
            self.fill_pictures()
        dialog.destroy()

    def fill_launchers(self, selected=None):
        for row in self.launchers.get_children():
            self.launchers.remove(row)
        for app_id in self.settings["launchers"]:
            info = app_info(app_id)
            row = Gtk.ListBoxRow()
            row.app_id = app_id
            line = Gtk.Box(spacing=8, border_width=4)
            line.pack_start(app_icon(info), False, False, 0)
            name = info.get_display_name() if info else app_id + " (not installed)"
            line.pack_start(Gtk.Label(label=name, xalign=0), True, True, 0)
            row.add(line)
            self.launchers.add(row)
            if app_id == selected:
                self.launchers.select_row(row)
        self.launchers.show_all()

    def add_launcher(self, _button):
        dialog = AddProgramDialog(self, self.settings["launchers"])
        if dialog.run() == Gtk.ResponseType.OK and dialog.chosen():
            self.settings["launchers"].append(dialog.chosen())
            self.fill_launchers(selected=dialog.chosen())
        dialog.destroy()

    def remove_launcher(self, _button):
        row = self.launchers.get_selected_row()
        if row:
            self.settings["launchers"].remove(row.app_id)
            self.fill_launchers()

    def move_launcher(self, step):
        row = self.launchers.get_selected_row()
        if not row:
            return
        items = self.settings["launchers"]
        i = items.index(row.app_id)
        j = i + step
        if 0 <= j < len(items):
            items[i], items[j] = items[j], items[i]
            self.fill_launchers(selected=row.app_id)

    def apply(self, _button):
        self.settings["autohide"] = self.autohide.get_active()
        try:
            save_settings(self.settings)
        except OSError as e:
            dialog = Gtk.MessageDialog(transient_for=self, modal=True,
                                       message_type=Gtk.MessageType.ERROR,
                                       buttons=Gtk.ButtonsType.CLOSE,
                                       text="The settings could not be saved")
            dialog.format_secondary_text(str(e))
            dialog.run()
            dialog.destroy()
            return
        # JWM reads its configuration again; the windows stay open.
        subprocess.run(["jwm", "-restart"], stdout=subprocess.DEVNULL,
                       stderr=subprocess.DEVNULL, check=False)


def main():
    if sys.argv[1:] == ["--check"]:
        settings = load_settings()
        print("settings:", CONFIG)
        print("background:", settings["background"])
        print("autohide:", "yes" if settings["autohide"] else "no")
        print("launchers:", " ".join(settings["launchers"]) or "none")
        return 0
    if len(sys.argv) > 1:
        print("usage: pivuan-desktop-settings [--check]", file=sys.stderr)
        return 2
    window = DesktopSettings()
    window.show_all()
    window.show_current_picture()
    Gtk.main()
    return 0


if __name__ == "__main__":
    sys.exit(main())
